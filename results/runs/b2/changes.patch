diff --git a/app/javascript/dashboard/components-next/Contacts/ContactsForm/specs/ContactsForm.spec.js b/app/javascript/dashboard/components-next/Contacts/ContactsForm/specs/ContactsForm.spec.js
new file mode 100644
index 0000000000..5460d1ef22
--- /dev/null
+++ b/app/javascript/dashboard/components-next/Contacts/ContactsForm/specs/ContactsForm.spec.js
@@ -0,0 +1,54 @@
+import { flushPromises, shallowMount } from '@vue/test-utils';
+import { describe, expect, it, vi } from 'vitest';
+
+import ComboBox from 'dashboard/components-next/combobox/ComboBox.vue';
+import ContactsForm from '../ContactsForm.vue';
+
+vi.mock('vue-i18n', () => ({
+  useI18n: () => ({ t: key => key }),
+}));
+
+vi.mock('dashboard/composables/useAccount', () => ({
+  useAccount: () => ({
+    currentAccount: { value: {} },
+    isCloudFeatureEnabled: () => false,
+  }),
+}));
+
+const mountComponent = (contactData = {}) =>
+  shallowMount(ContactsForm, {
+    props: {
+      contactData: { id: 1, name: 'John Doe', ...contactData },
+    },
+  });
+
+const preferredLanguageComboBox = wrapper =>
+  wrapper
+    .findAllComponents(ComboBox)
+    .find(comboBox =>
+      comboBox.props('placeholder').includes('PREFERRED_LANGUAGE')
+    );
+
+describe('ContactsForm', () => {
+  it('renders the current preferred language', () => {
+    const wrapper = mountComponent({ preferredLanguage: 'pt_BR' });
+    const comboBox = preferredLanguageComboBox(wrapper);
+
+    expect(comboBox.props('modelValue')).toBe('pt_BR');
+    expect(comboBox.props('options')).toContainEqual({
+      label: 'Portuguese (Brazil)',
+      value: 'pt_BR',
+    });
+  });
+
+  it('emits the updated preferred language', async () => {
+    const wrapper = mountComponent();
+
+    preferredLanguageComboBox(wrapper).vm.$emit('update:modelValue', 'pt_BR');
+    await flushPromises();
+
+    expect(wrapper.emitted('update').at(-1)[0]).toMatchObject({
+      preferredLanguage: 'pt_BR',
+    });
+  });
+});
