diff --git a/app/javascript/dashboard/components-next/Contacts/ContactsForm/ContactsForm.spec.js b/app/javascript/dashboard/components-next/Contacts/ContactsForm/ContactsForm.spec.js
new file mode 100644
index 0000000000..48058667c4
--- /dev/null
+++ b/app/javascript/dashboard/components-next/Contacts/ContactsForm/ContactsForm.spec.js
@@ -0,0 +1,65 @@
+import { flushPromises, shallowMount } from '@vue/test-utils';
+import { describe, expect, it, vi } from 'vitest';
+
+import ContactsForm from './ContactsForm.vue';
+import ComboBox from 'dashboard/components-next/combobox/ComboBox.vue';
+
+vi.mock('vue-i18n', () => ({
+  useI18n: () => ({ t: key => key }),
+}));
+
+vi.mock('dashboard/composables/useAccount', () => ({
+  useAccount: () => ({
+    currentAccount: { value: { id: 1 } },
+    isCloudFeatureEnabled: () => false,
+  }),
+}));
+
+const contactData = {
+  id: 1,
+  name: 'Jane Doe',
+  email: 'jane@example.com',
+  phoneNumber: '+123456789',
+  preferredLanguage: 'es',
+  additionalAttributes: {},
+};
+
+const mountComponent = (props = {}) =>
+  shallowMount(ContactsForm, { props: { contactData, ...props } });
+
+const findPreferredLanguageComboBox = wrapper =>
+  wrapper
+    .findAllComponents(ComboBox)
+    .find(comboBox =>
+      comboBox
+        .props('options')
+        .some(({ label, value }) => value === 'es' && label === 'Spanish (es)')
+    );
+
+describe('ContactsForm', () => {
+  it('populates the preferred language from the contact', () => {
+    const wrapper = mountComponent();
+
+    expect(wrapper.vm.state.preferredLanguage).toBe('es');
+    expect(findPreferredLanguageComboBox(wrapper).props('modelValue')).toBe(
+      'es'
+    );
+  });
+
+  it('defaults the preferred language to an empty value when the contact has none', () => {
+    const wrapper = mountComponent({
+      contactData: { ...contactData, preferredLanguage: null },
+    });
+
+    expect(wrapper.vm.state.preferredLanguage).toBe('');
+  });
+
+  it('emits the selected preferred language', async () => {
+    const wrapper = mountComponent();
+
+    findPreferredLanguageComboBox(wrapper).vm.$emit('update:modelValue', 'fr');
+    await flushPromises();
+
+    expect(wrapper.emitted('update').at(-1)[0].preferredLanguage).toBe('fr');
+  });
+});
