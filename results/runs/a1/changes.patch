+++ b/app/javascript/dashboard/components-next/Contacts/ContactsForm/ContactsForm.spec.js
@@ -0,0 +1,94 @@
+import { flushPromises, mount } from '@vue/test-utils';
+import ContactsForm from './ContactsForm.vue';
+
+vi.mock('vue-i18n', () => ({
+  useI18n: () => ({ t: key => key }),
+}));
+
+vi.mock('dashboard/composables/useAccount', () => ({
+  useAccount: () => ({
+    currentAccount: { value: { id: 1 } },
+    isCloudFeatureEnabled: () => false,
+  }),
+}));
+
+const PREFERRED_LANGUAGE_PLACEHOLDER =
+  'CONTACTS_LAYOUT.CARD.EDIT_DETAILS_FORM.FORM.PREFERRED_LANGUAGE.PLACEHOLDER';
+
+const ComboBoxStub = {
+  props: ['modelValue', 'options', 'placeholder'],
+  emits: ['update:modelValue'],
+  template: '<div />',
+};
+
+const InputStub = {
+  props: ['modelValue', 'placeholder'],
+  emits: ['update:modelValue'],
+  template: '<input />',
+};
+
+const contactData = {
+  id: 7,
+  name: 'Ada Lovelace',
+  email: 'ada@example.com',
+  phoneNumber: '+15551234567',
+  preferredLanguage: 'es',
+  additionalAttributes: {},
+};
+
+const mountForm = (props = {}) =>
+  mount(ContactsForm, {
+    props: { contactData, ...props },
+    global: {
+      stubs: {
+        ComboBox: ComboBoxStub,
+        Input: InputStub,
+        PhoneNumberInput: true,
+        CompanySelector: true,
+        Icon: true,
+      },
+    },
+  });
+
+const findLanguageComboBox = wrapper =>
+  wrapper
+    .findAllComponents(ComboBoxStub)
+    .find(
+      combobox =>
+        combobox.props('placeholder') === PREFERRED_LANGUAGE_PLACEHOLDER
+    );
+
+describe('ContactsForm', () => {
+  it("shows the contact's saved preferred language", () => {
+    const languageComboBox = findLanguageComboBox(mountForm());
+
+    expect(languageComboBox.props('modelValue')).toBe('es');
+  });
+
+  it('emits the selected preferred language', async () => {
+    const wrapper = mountForm();
+
+    await findLanguageComboBox(wrapper).vm.$emit('update:modelValue', 'fr');
+    await flushPromises();
+
+    const [payload] = wrapper.emitted('update').at(-1);
+    expect(payload.preferredLanguage).toBe('fr');
+  });
+
+  it('emits a blank preferred language when the selection is cleared', async () => {
+    const wrapper = mountForm();
+
+    await findLanguageComboBox(wrapper).vm.$emit('update:modelValue', '');
+    await flushPromises();
+
+    const [payload] = wrapper.emitted('update').at(-1);
+    expect(payload.preferredLanguage).toBe('');
+  });
+
+  it('offers ISO 639-1 languages without regional locale variants', () => {
+    const options = findLanguageComboBox(mountForm()).props('options');
+
+    expect(options).toContainEqual({ label: 'Spanish', value: 'es' });
+    expect(options.map(option => option.value)).not.toContain('pt_BR');
+  });
+});
