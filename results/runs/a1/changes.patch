+      expect { contact.update!(preferred_language: 'klingon') }.to raise_error(ActiveRecord::RecordInvalid)
+    end
+
+    it 'throws error for a regional locale variant' do
+      contact = create(:contact)
+      expect { contact.update!(preferred_language: 'pt_BR') }.to raise_error(ActiveRecord::RecordInvalid)
+    end
+
+    it 'throws error for an uppercased code' do
+      contact = create(:contact)
+      expect { contact.update!(preferred_language: 'ES') }.to raise_error(ActiveRecord::RecordInvalid)
+    end
+
+    it 'sets preferred language to nil when empty string' do
+      contact = create(:contact, preferred_language: '')
+      expect(contact.preferred_language).to be_nil
+    end
+
+    it 'clears an existing preferred language when empty string is passed' do
+      contact = create(:contact, preferred_language: 'de')
+      expect(contact.update!(preferred_language: '')).to be true
+      expect(contact.reload.preferred_language).to be_nil
+    end
+  end
+
+  describe '#push_event_data' do
+    it 'includes the preferred language' do
+      contact = create(:contact, preferred_language: 'fr')
+      expect(contact.push_event_data).to include(preferred_language: 'fr')
+    end
+  end
+
+  describe '#webhook_data' do
+    it 'includes the preferred language' do
+      contact = create(:contact, preferred_language: 'fr')
+      expect(contact.webhook_data).to include(preferred_language: 'fr')
+    end
+  end
